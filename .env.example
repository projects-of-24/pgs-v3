NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SITE_URL=http://localhost:7100
# Server-only deployment gate. Enable only after the Supabase Google provider,
# client credentials, Site URL, and allowed callback URL are configured.
SUPABASE_GOOGLE_AUTH_ENABLED=false
# Server-only. Required only by the authenticated Premium purchase event boundary.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only Postgres URL — needed for CLI migration apply scripts (e.g. COURSE2b).
# Supabase Dashboard → Project Settings → Database → Connection string (URI).
# DATABASE_URL=
# DIRECT_URL=
PREMIUM_PURCHASE_WEBHOOK_SECRET=
# Server-only, independent random values of at least 32 characters.
AUTH_FLOW_SECRET=
RATE_LIMIT_HASH_SECRET=

# Explicit local/preview-only Admin/CMS fixture gate. Never use a production ref.
PGS_PREVIEW_FIXTURES=false
PGS_PREVIEW_PROJECT_REF=
PGS_PREVIEW_FIXTURE_PASSWORD=

# Loopboard interactive lab (no-login Ops↔Student sandbox). Never on Vercel production.
# Seed: LOOPBOARD_LAB_SEED=I_UNDERSTAND_LAB_ONLY pnpm lab:loopboard-seed
LOOPBOARD_LAB_ENABLED=false
LOOPBOARD_LAB_SECRET=
# Track Progress Premium lab (separate pair). Seed:
# PROGRESS_LAB_SEED=I_UNDERSTAND_LAB_ONLY pnpm lab:progress-seed

# Parallel Sanity trial (M1) — Studio at /sanity, preview at /preview/sanity-courses.
# Does NOT replace Ops CMS or Supabase. Create a project at https://www.sanity.io/manage
# and add CORS origin http://localhost:7000. Leave blank to show setup notice only.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# Server-only — seed Ops course 64 into Sanity trial doc (Editor token)
SANITY_API_WRITE_TOKEN=
SANITY_COURSE_DOCUMENT_ID=125ffefb-af81-47f4-8c28-f754944bdc69

# AI Analyst / Assistant V1 — server-only. Never expose to browser.
# If unset, AI features are disabled gracefully (core PGS continues to work).
OPENAI_API_KEY=
# Optional: override AI model. Allowlisted to known OpenAI json_object-capable models.
# Default: gpt-4o-mini
PGS_AI_MODEL=
